# ---- Public address of this server (HTTPS, reachable by Bitrix24) ----
# DOMAIN is used by Caddy (docker-compose) to get a free HTTPS certificate.
DOMAIN=wa.example.com
PUBLIC_URL=https://wa.example.com
PORT=3000

# ---- Bitrix24 application (Developer resources -> Local or Market application) ----
BITRIX_CLIENT_ID=local.xxxxxxxxxxxxxx.xxxxxxxx
BITRIX_CLIENT_SECRET=change-me

# ---- Infrastructure (docker-compose sets these itself; only needed when running without Docker) ----
POSTGRES_PASSWORD=change-me-too
DATABASE_URL=postgres://wa:wa@localhost:5432/wa
REDIS_URL=redis://localhost:6379

# ---- Secrets: generate each with `openssl rand -base64 32` ----
# Encrypts OAuth tokens and WhatsApp login keys at rest. Never change it after first run.
TOKEN_ENC_KEY=
# Signs the admin-UI session token and media links.
APP_SECRET=

# ---- Connector identity (bump CONNECTOR_VERSION to re-register on every portal) ----
CONNECTOR_ID=wa_qr_connector
CONNECTOR_NAME=WhatsApp
CONNECTOR_VERSION=1

# ---- Media ----
MEDIA_DIR=./media
MEDIA_MAX_AGE_DAYS=7

# ---- Anti-ban pacing (milliseconds between outgoing messages per number) ----
SEND_MIN_INTERVAL_MS=1500

LOG_LEVEL=info

# ---- Billing (Stripe, priced per linked WhatsApp number) ----
# Leave STRIPE_SECRET_KEY empty to disable billing: every portal is then unlimited (self-hosted use).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# A recurring, per-unit, monthly Price (quantity = number of WhatsApp numbers)
STRIPE_PRICE_ID=
TRIAL_DAYS=14
TRIAL_MAX_NUMBERS=5
# member_id of portals that never pay (e.g. your own), comma separated
BILLING_EXEMPT_MEMBER_IDS=

# ---- Legal pages (/legal/terms and /legal/privacy - required by the Bitrix24 Market) ----
LEGAL_PRODUCT_NAME=WhatsApp QR Connector for Bitrix24
LEGAL_COMPANY_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_ADDRESS=
LEGAL_GOVERNING_LAW=
