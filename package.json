{
  "name": "bitrix24-whatsapp",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted WhatsApp (QR / linked device) connector for Bitrix24 - Open Lines, CRM (Lead, Deal, Contact, Company, Smart Processes), automation robots and SMS provider.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json && cp src/db/schema.sql dist/db/schema.sql",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "baileys": "7.0.0-rc14",
    "bullmq": "6.7.6",
    "hono": "4.13.18",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/pg": "8.15.6",
    "@types/qrcode": "1.5.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
